{
	"format_on_save": "on",
	"formatter": "prettier",
	"hard_tabs": true,
	"tab_size": 2,
	"ensure_final_newline_on_save": true,
	"remove_trailing_whitespace_on_save": true,
	"preferred_line_length": 80,
	"show_wrap_guides": true,
	"wrap_guides": [80],
	"file_scan_exclusions": [
		"**/.git",
		"**/node_modules",
		"**/dist",
		"**/dist-e2e",
		"**/test-results",
		"**/playwright-report"
	],
	"languages": {
		"Svelte": {
			"formatter": "prettier",
			"tab_size": 2,
			"hard_tabs": true
		}
	}
}
