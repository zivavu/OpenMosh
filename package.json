{
	"name": "openmosh",
	"private": true,
	"version": "0.9.27",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json && tsc -p lab/tsconfig.json && tsc -p tsconfig.test.json",
		"test": "bun test src",
		"test:coverage": "bun test src --coverage",
		"test:e2e": "playwright test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:bpm": "BPM_MUSIC=1 bun test src/lib/audio/tempo.music",
		"prepare": "git config core.hooksPath .githooks || true"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tsconfig/svelte": "^5.0.8",
		"@types/bun": "^1.4.3",
		"@types/draco3d": "^1.4.10",
		"@types/node": "^26.6.5",
		"fake-indexeddb": "^6.2.6",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "~6.0.3",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"draco3d": "1.5.7",
		"lucide-svelte": "^1.0.1",
		"mediabunny": "^1.61.6",
		"meshoptimizer": "^1.3.0"
	}
}
